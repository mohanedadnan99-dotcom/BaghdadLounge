# Telegram (keep these only in Vercel Environment Variables)
TELEGRAM_BOT_TOKEN=(توكن)
TELEGRAM_CHAT_ID=(معرف_كروب_التلكرام)

# Wayl
WAYL_API_KEY=(مفتاح_Wayl)
WAYL_WEBHOOK_SECRET=(مفتاح_توقيع_Webhook)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Neon / Vercel Postgres
DATABASE_URL=(رابط_قاعدة_البيانات)

# Google Sheet operations sync
OPS_SHEETS_WEBHOOK_URL=(Google Apps Script Web App URL)
OPS_SHEETS_WEBHOOK_TOKEN=(اختياري)

# OpenAI ticket reader (server-side only)
OPENAI_API_KEY=(مفتاح_OpenAI)
OPENAI_TICKET_MODEL=gpt-5.6
